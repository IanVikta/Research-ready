{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|site\\.webmanifest|favicon\\.svg|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
